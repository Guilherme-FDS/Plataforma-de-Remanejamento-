# Copie para .env.local e preencha. O .env.local NÃO vai para o git.
#
# Supabase → Project Settings → API
#   Project URL        -> NEXT_PUBLIC_SUPABASE_URL
#   anon public        -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#     (contas novas chamam de "Publishable key", sb_publishable_...)
#
# A anon key é pública por design: ela vai no bundle e qualquer visitante do
# app publicado consegue lê-la. Quem protege os dados é a RLS, não ela.
# Nunca use aqui a service_role key — essa ignora RLS.

NEXT_PUBLIC_SUPABASE_URL=https://jbtemcapbchoxppnrbqe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
