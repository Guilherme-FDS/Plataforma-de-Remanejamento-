# Copie para .env.local e preencha. O .env.local NÃO vai para o git.
#
# Supabase → Project Settings → API
#   Project URL        -> NEXT_PUBLIC_SUPABASE_URL
#   anon public        -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#     (contas novas chamam de "Publishable key", sb_publishable_...)
#   service_role       -> SUPABASE_SERVICE_ROLE_KEY  (NUNCA exponha ao cliente!)
#
# A anon key é pública por design: ela vai no bundle e qualquer visitante do
# app publicado consegue lê-la. Quem protege os dados é a RLS, não ela.
# A service_role key ignora RLS — use apenas em Server Actions/Route Handlers.
#
# NEXT_PUBLIC_SITE_URL: URL pública do app (sem barra final).
#   - Local:   http://localhost:3000
#   - Vercel:  https://seu-app.vercel.app
#   Usada para montar links de convite e redefinição de senha.
#
# Supabase: Authentication → URL Configuration → adicione:
#   <NEXT_PUBLIC_SITE_URL>/auth/callback

NEXT_PUBLIC_SUPABASE_URL=https://jbtemcapbchoxppnrbqe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
